# Copy to backend/.env (or export) and adjust. Every value has a safe development default.
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# PostgreSQL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://resume_app:dev_only_password@localhost:5432/resume_intel
DB_POOL_SIZE=5
# Used ONLY by the test suite. The database name must end in "_test" (tests drop all tables).
TEST_DATABASE_URL=postgresql+psycopg://resume_app:dev_only_password@localhost:5432/resume_intel_test

# Only needed when the SPA is served from a different origin than the API (comma separated).
CORS_ORIGINS=

# Sessions
SESSION_COOKIE_NAME=ri_session
SESSION_COOKIE_SECURE=false    # must be true in production (HTTPS)
SESSION_ABSOLUTE_TTL_HOURS=168
SESSION_IDLE_TTL_HOURS=24
REGISTRATION_ENABLED=true
PASSWORD_MIN_LENGTH=10

# Auth rate limits (per process)
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# LLM provider (D-03). Leave LLM_PROVIDER empty => "AI provider not configured".
# Groq:   LLM_PROVIDER=groq, LLM_MODEL=openai/gpt-oss-120b (or openai/gpt-oss-20b),
#         LLM_API_KEY=<Groq key from console.groq.com, kept in the secret store, never committed>.
#         For a Groq model without JSON-schema support, also set LLM_RESPONSE_FORMAT=json_object.
# OpenAI: LLM_PROVIDER=openai, LLM_MODEL=<model with structured outputs>, LLM_API_KEY=<key>.
# LLM_BASE_URL is optional; it defaults to the provider's API.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# json_schema (default) or json_object
LLM_RESPONSE_FORMAT=json_schema
# Raise small output limits for reasoning models (groq already uses at least 1024)
LLM_MIN_OUTPUT_TOKENS=0
# AI calls per user per UTC day (0 = no limit). A rewrite with its claim check is 2 calls.
AI_DAILY_LIMIT_PER_USER=100

# Email (provider pending, D-07). Empty => password reset is hidden.
# smtp works with any provider that offers SMTP; console logs mail (development only).
EMAIL_PROVIDER=
EMAIL_FROM=
# Public URL of the web app, used in reset links
APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
# starttls (587), ssl (465) or none (development only)
SMTP_SECURITY=starttls
SMTP_USERNAME=
# Secret: set in the environment, never commit
SMTP_PASSWORD=
PASSWORD_RESET_TTL_MINUTES=30

# File storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/storage
# STORAGE_BACKEND=s3: any service with the S3 API (provider pending, D-06)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
# Secret: set in the environment, never commit
S3_SECRET_ACCESS_KEY=
# path or virtual
S3_ADDRESSING=path
S3_PREFIX=
MAX_UPLOAD_BYTES=10485760

# Requests at or over this many milliseconds log a "slow_request" warning (0 disables).
SLOW_REQUEST_MS=1000

# Reverse proxy: comma-separated IPs whose X-Forwarded-For is trusted (used by uvicorn).
# Without this, rate limiting would see every user as the proxy's IP.
FORWARDED_ALLOW_IPS=127.0.0.1
